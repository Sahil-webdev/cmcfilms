PORT=5001
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/cmcfilms?retryWrites=true&w=majority
# Create a unique 32+ character random value, for example: openssl rand -base64 48
JWT_SECRET=<generate-a-unique-strong-secret>
JWT_EXPIRES_IN=8h
# Comma-separated origins are supported. Use your live domain in production.
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ImageKit Media Library (all uploaded images and videos)
# Generate these at ImageKit Dashboard → Developer options → API keys.
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxxx
